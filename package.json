{
  "name": "dsh-switch-fast",
  "version": "1.1.1",
  "description": "DSH Web 对话加速：分批加载历史，短时复用最近的对话。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md"],
  "scripts": {
    "check": "node --check lib/client.js && node --test tests/",
    "test": "node --test tests/"
  },
  "engines": { "node": ">=22", "dsh": "0.2.2-rc.3" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-api-session-controller", "@deepseek-ai/dsh-client-ui-workspace"],
      "external": ["@deepseek-ai/dsh-api-session-controller/client"]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hh5631/dsh-switch-fast.git"
  },
  "homepage": "https://github.com/hh5631/dsh-switch-fast#readme",
  "bugs": {
    "url": "https://github.com/hh5631/dsh-switch-fast/issues"
  },
  "license": "MIT"
}
